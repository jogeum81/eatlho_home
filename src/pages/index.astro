---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
---

<Base title="EATLHO">
  <Header />

  <main>
    <!-- ============================================================
         1. HERO
         ============================================================ -->
    <section class="hero">
      <div class="container">
        <p class="type-section-title hero-label">냉장고 관리 앱</p>
        <h1 class="type-headline hero-headline">냉장고를,<br />말로 관리하세요.</h1>
        <p class="hero-sub">
          장보기부터 냉장고 관리, AI 레시피 추천까지<br />
          — 한 줄 입력으로 끝.
        </p>

        <!-- AI 만능창 목업: 무지개 그라데이션 보더 액센트 -->
        <div class="ai-input-mock" aria-label="AI 만능창 목업">
          <div class="ai-input-inner">
            <span class="ai-input-placeholder">계란 사서 냉장고에 넣어줘</span>
            <span class="ai-input-cursor" aria-hidden="true"></span>
          </div>
        </div>

        <!-- CTA: 현재 coming soon 상태. 추후 스토어 배지로 교체 예정 -->
        <!-- TODO: Google Play / App Store 배지로 교체. href에 스토어 URL 삽입 -->
        <div class="hero-cta">
          <span class="cta-coming-soon">Google Play에서 곧 만나요</span>
        </div>
      </div>
    </section>

    <!-- ============================================================
         2. 핵심 가치 (01/02/03)
         ============================================================ -->
    <Section label="핵심 가치" id="values">
      <div class="values-grid">
        <div class="value-item">
          <p class="type-mono-number value-number">01</p>
          <h2 class="value-title">AI 만능창</h2>
          <p class="value-desc">
            "계란 사서 냉장고에 넣어줘" 한 마디면 끝.
            장보기·재료 등록·레시피 검색을 하나의 자연어 입력창으로 처리합니다.
          </p>
        </div>

        <hr class="value-divider" />

        <div class="value-item">
          <p class="type-mono-number value-number">02</p>
          <h2 class="value-title">순환하는 동선</h2>
          <p class="value-desc">
            장보기 → 냉장고 → 레시피 → 다시 장보기.
            끊기지 않고 이어지는 식생활 생태계.
          </p>
        </div>

        <hr class="value-divider" />

        <div class="value-item">
          <p class="type-mono-number value-number">03</p>
          <h2 class="value-title">똑똑한 관리</h2>
          <p class="value-desc">
            구매 시점별 유통기한 추적, 오래된 재료부터 차감(FIFO),
            입출고 이력 완전 보존.
          </p>
        </div>
      </div>
    </Section>

    <!-- ============================================================
         3. 기능 섹션 (장보기 / 냉장고 / 레시피)
         ============================================================ -->
    <Section label="주요 기능" id="features">
      <div class="features-grid">
        <div class="feature-item">
          <p class="type-mono-number feature-tag">SHOPPING</p>
          <h2 class="feature-title">장보기</h2>
          <p class="feature-desc">
            마트 동선에 맞춘 카테고리 자동 분류.
            구매 체크하면 냉장고에 자동 등록됩니다.
            무엇을 사야 할지, AI가 함께 정리해 드립니다.
          </p>
        </div>

        <div class="feature-item">
          <p class="type-mono-number feature-tag">FRIDGE</p>
          <h2 class="feature-title">냉장고</h2>
          <p class="feature-desc">
            로트 단위로 구매 시점별 유통기한을 개별 관리.
            임박 재료를 D-day로 강조해 식품 낭비를 줄입니다.
          </p>
        </div>

        <div class="feature-item">
          <p class="type-mono-number feature-tag">RECIPE</p>
          <h2 class="feature-title">레시피</h2>
          <p class="feature-desc">
            보유 재료 기반 AI 추천. 부족한 재료는 한 번에 장보기로.
            요리하면 재료가 자동 차감됩니다.
          </p>
        </div>
      </div>
    </Section>

    <!-- ============================================================
         4. 순환 생태계 다이어그램 (CSS, 이미지 X)
         ============================================================ -->
    <Section label="순환 생태계" id="cycle">
      <div class="cycle-wrapper">
        <div class="cycle-diagram" role="img" aria-label="장보기 → 냉장고 → 레시피 → 장보기 순환">
          <div class="cycle-step">
            <span class="cycle-label">장보기</span>
          </div>
          <span class="cycle-arrow" aria-hidden="true">→</span>
          <div class="cycle-step">
            <span class="cycle-label">냉장고</span>
          </div>
          <span class="cycle-arrow" aria-hidden="true">→</span>
          <div class="cycle-step">
            <span class="cycle-label">레시피</span>
          </div>
          <span class="cycle-arrow cycle-arrow--loop" aria-hidden="true">↩</span>
        </div>
        <p class="cycle-copy">
          사고, 채우고, 해먹고, 다시 사고.<br />
          잇냉은 식생활의 한 바퀴를 매끄럽게 잇습니다.
        </p>
      </div>
    </Section>

    <!-- ============================================================
         5. 마무리 CTA
         ============================================================ -->
    <Section label="" id="cta" dividerTop={true}>
      <div class="final-cta">
        <h2 class="final-cta-title">지금 바로 시작하세요.</h2>
        <p class="final-cta-sub">냉장고의 재료를 말로 관리하는 새로운 방법.</p>
        <!-- TODO: 스토어 출시 후 아래 주석을 실제 배지 링크로 교체 -->
        <div class="final-cta-badges">
          <span class="cta-coming-soon">Google Play — 출시 예정</span>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-top: 72px;
    padding-bottom: var(--padding-section);
  }

  .hero-label {
    margin-bottom: 16px;
  }

  .hero-headline {
    margin-bottom: 20px;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    color: var(--color-gray);
    line-height: var(--line-height-relaxed);
    margin-bottom: 40px;
    max-width: 480px;
  }

  /* AI 만능창 목업: 무지개 그라데이션 보더 */
  .ai-input-mock {
    position: relative;
    display: inline-flex;
    max-width: 480px;
    width: 100%;
    padding: 2px; /* 그라데이션 보더 두께 */
    background: var(--gradient-rainbow);
    background-size: 200% 100%;
    border-radius: 6px;
    margin-bottom: 40px;
    animation: rainbow-shift 4s linear infinite;
  }

  .ai-input-inner {
    display: flex;
    align-items: center;
    width: 100%;
    background: var(--color-white);
    border-radius: 4px;
    padding: 14px 16px;
    gap: 4px;
  }

  .ai-input-placeholder {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    color: var(--color-silver);
    letter-spacing: 0.3px;
  }

  .ai-input-cursor {
    display: inline-block;
    width: 2px;
    height: 16px;
    background: var(--color-purple);
    animation: blink 1s step-end infinite;
    flex-shrink: 0;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @keyframes rainbow-shift {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  /* CTA */
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cta-coming-soon {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-silver);
    border: 1px solid var(--color-light-gray);
    padding: 10px 20px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  /* ---- 핵심 가치 ---- */
  .values-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .value-divider {
    margin: 32px 0;
  }

  .value-item {
    display: grid;
    grid-template-columns: 48px 200px 1fr;
    gap: 0 24px;
    align-items: start;
  }

  .value-number {
    padding-top: 4px;
  }

  .value-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: 1px;
    color: var(--color-black);
  }

  .value-desc {
    font-size: var(--font-size-base);
    color: var(--color-gray);
    line-height: var(--line-height-relaxed);
    max-width: 400px;
  }

  /* ---- 기능 섹션 ---- */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    border-top: 1px solid var(--color-light-gray);
  }

  .feature-item {
    padding-top: 24px;
    border-top: 2px solid var(--color-black);
    margin-top: -1px;
  }

  .feature-tag {
    margin-bottom: 12px;
  }

  .feature-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 1px;
    margin-bottom: 12px;
    color: var(--color-black);
  }

  .feature-desc {
    font-size: var(--font-size-md);
    color: var(--color-gray);
    line-height: var(--line-height-relaxed);
  }

  /* ---- 순환 생태계 ---- */
  .cycle-wrapper {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: flex-start;
  }

  .cycle-diagram {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cycle-step {
    border: 1px solid var(--color-light-gray);
    padding: 10px 20px;
    border-radius: 2px;
  }

  .cycle-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    letter-spacing: 1px;
    color: var(--color-black);
  }

  .cycle-arrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xl);
    color: var(--color-silver);
    line-height: 1;
  }

  .cycle-arrow--loop {
    color: var(--color-purple);
  }

  .cycle-copy {
    font-size: var(--font-size-lg);
    color: var(--color-charcoal);
    line-height: var(--line-height-relaxed);
    max-width: 480px;
  }

  /* ---- 마무리 CTA ---- */
  .final-cta {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .final-cta-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-xxl);
    font-weight: var(--font-weight-bold);
    letter-spacing: 2px;
    color: var(--color-black);
  }

  .final-cta-sub {
    font-size: var(--font-size-base);
    color: var(--color-gray);
    line-height: var(--line-height-relaxed);
  }

  .final-cta-badges {
    margin-top: 8px;
  }

  /* ---- 반응형 ---- */
  @media (max-width: 600px) {
    .value-item {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
    }

    .value-title {
      grid-column: 2;
    }

    .value-desc {
      grid-column: 1 / -1;
      padding-left: 40px;
      max-width: 100%;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .feature-item {
      padding-bottom: 32px;
    }

    .cycle-diagram {
      gap: 10px;
    }
  }
</style>
